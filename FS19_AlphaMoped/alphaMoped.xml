<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!--
    Мопед Альфа 110 для Farming Simulator 19

    ВАЖНО ПРО ФИЗИКУ ДВУХКОЛЁСНОЙ ТЕХНИКИ:
    физика FS19 не умеет держать равновесие на двух колёсах. Поэтому здесь,
    как и во всех рабочих мото-модах, используется 4 физических колеса,
    сдвинутых к осевой линии на +-0.055 м. Видимых колёс при этом два:
    меши висят на driveNode левых колёс, правые колёса невидимые.
    Наклон в поворотах делает специализация alphaMopedLean (чисто визуально).

    Имена узлов берутся из i3dMappings в самом низу файла и должны совпадать
    с именами объектов в alphaMoped.i3d (их создаёт tools/blender_build_alpha.py).
-->
<!--
    ВНИМАНИЕ: в type= пишется ИМЯ ТИПА БЕЗ имени мода.
    Игра сама подставляет префикс: alphaMoped -> FS19_AlphaMoped.alphaMoped.
    Если написать "FS19_AlphaMoped.alphaMoped", получится задвоение
    "FS19_AlphaMoped.FS19_AlphaMoped.alphaMoped" и техника не загрузится.
-->
<vehicle type="alphaMoped">

    <annotation>Alpha 110 moped</annotation>

    <storeData>
        <name>
            <ru>Альфа 110</ru>
            <en>Alpha 110</en>
        </name>
        <specs>
            <power>7</power>
            <maxSpeed>65</maxSpeed>
        </specs>
        <functions>
            <function>$l10n_function_alphaMoped</function>
        </functions>
        <image>store_alphaMoped.dds</image>
        <price>1900</price>
        <lifetime>300</lifetime>
        <rotation>0</rotation>
        <brand>LIZARD</brand>
        <category>cars</category>
        <shopTranslationOffset>0 0 0</shopTranslationOffset>
        <shopRotationOffset>0 0 0</shopRotationOffset>
        <vertexBufferMemoryUsage>0</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>0</indexBufferMemoryUsage>
        <textureMemoryUsage>0</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
    </storeData>

    <base>
        <typeDesc>$l10n_typeDesc_alphaMoped</typeDesc>
        <filename>alphaMoped.i3d</filename>
        <size width="0.72" length="1.95" lengthOffset="0"/>
        <!-- центр масс низко и чуть назад: мопед меньше клюёт носом -->
        <components>
            <component centerOfMass="0 0.18 -0.10"
                       solverIterationCount="10" mass="98"/>
        </components>
        <schemaOverlay name="DEFAULT"/>
        <speedRotatingParts>
            <speedRotatingPart node="chainSprocket" wheelIndex="3" wheelScale="2.4"/>
        </speedRotatingParts>
    </base>

    <wheels>
        <wheelConfigurations>
            <wheelConfiguration name="$l10n_configuration_valueDefault" price="0">
                <wheels autoRotateBackSpeed="3.5">

                    <!-- 1: переднее левое (видимое, рулевое) -->
                    <wheel isLeft="true" hasTireTracks="true" tireTrackAtlasIndex="0">
                        <physics repr="wheelFrontLeft" driveNode="wheelFrontMesh"
                                 radius="0.335" width="0.075" mass="0.006"
                                 rotSpeed="55" rotMax="34" rotMin="-34"
                                 suspTravel="0.10" spring="22" damper="42"
                                 restLoad="0.30" forcePointRatio="0.35"
                                 maxLongStiffness="25" maxLatStiffness="35"
                                 maxLatStiffnessLoad="1.4" frictionScale="1.15"/>
                    </wheel>

                    <!-- 2: переднее правое (невидимый стабилизатор) -->
                    <wheel isLeft="false" hasTireTracks="false">
                        <physics repr="wheelFrontRight"
                                 radius="0.335" width="0.075" mass="0.006"
                                 rotSpeed="55" rotMax="34" rotMin="-34"
                                 suspTravel="0.10" spring="22" damper="42"
                                 restLoad="0.30" forcePointRatio="0.35"
                                 maxLongStiffness="25" maxLatStiffness="35"
                                 maxLatStiffnessLoad="1.4" frictionScale="1.15"/>
                    </wheel>

                    <!-- 3: заднее левое (видимое, ведущее) -->
                    <wheel isLeft="true" hasTireTracks="true" tireTrackAtlasIndex="0">
                        <physics repr="wheelRearLeft" driveNode="wheelRearMesh"
                                 radius="0.335" width="0.085" mass="0.008"
                                 suspTravel="0.12" spring="26" damper="45"
                                 restLoad="0.45" forcePointRatio="0.35"
                                 maxLongStiffness="28" maxLatStiffness="38"
                                 maxLatStiffnessLoad="1.6" frictionScale="1.15"/>
                    </wheel>

                    <!-- 4: заднее правое (невидимый стабилизатор, ведущее) -->
                    <wheel isLeft="false" hasTireTracks="false">
                        <physics repr="wheelRearRight"
                                 radius="0.335" width="0.085" mass="0.008"
                                 suspTravel="0.12" spring="26" damper="45"
                                 restLoad="0.45" forcePointRatio="0.35"
                                 maxLongStiffness="28" maxLatStiffness="38"
                                 maxLatStiffnessLoad="1.6" frictionScale="1.15"/>
                    </wheel>
                </wheels>
            </wheelConfiguration>
        </wheelConfigurations>
    </wheels>

    <motorized>
        <motorConfigurations>
            <motorConfiguration name="110 cc" hp="7" price="0">
                <!--
                    139FMB, 110 см3, ~7 л.с., 4 передачи.
                    torqueScale подобран так, чтобы мопед бодро ехал по асфальту
                    и заметно вяз на пашне.
                -->
                <motor torqueScale="0.09" minRpm="1300" maxRpm="8500"
                       maxForwardSpeed="65" maxBackwardSpeed="6"
                       accelerationLimit="6" brakeForce="4.5"
                       lowBrakeForceScale="0.35" lowBrakeForceSpeedLimit="1.2"
                       ptoMotorRpmRatio="1"/>
                <transmission name="4-speed" axleRatio="2.9">
                    <forwardGear gearRatio="9.5"/>
                    <forwardGear gearRatio="6.2"/>
                    <forwardGear gearRatio="4.4"/>
                    <forwardGear gearRatio="3.3"/>
                    <backwardGear gearRatio="9.5"/>
                </transmission>
            </motorConfiguration>
        </motorConfigurations>

        <consumerConfigurations>
            <consumerConfiguration>
                <consumer fillUnitIndex="1" fillType="DIESEL" capacity="4" usage="0.35"
                          refillLitersPerSecond="1"/>
            </consumerConfiguration>
        </consumerConfigurations>

        <!-- Звук: временно берём базовый мотор, свои семплы кладём в sounds/ -->
        <sounds>
            <motorStart template="carMotorStart" linkNode="engineNode" volumeScale="0.7"/>
            <motorStop  template="carMotorStop"  linkNode="engineNode" volumeScale="0.7"/>
            <motor      template="carMotorSmall" linkNode="engineNode"
                        volumeScale="0.8" pitchScale="1.35"/>
        </sounds>

        <exhaustEffects>
            <exhaustEffect node="exhaustEffectNode"
                           filename="$data/shared/effects/exhaust/exhaustSmall.i3d"
                           minRpmColor="0.0384 0.0359 0.0296 0.35"
                           maxRpmColor="0.0384 0.0359 0.0296 0.75"
                           minRpmScale="0.25 0.25 0.25 0.6"
                           maxRpmScale="0.4 0.4 0.4 1.3"/>
        </exhaustEffects>
    </motorized>

    <fillUnit>
        <fillUnitConfigurations>
            <fillUnitConfiguration>
                <fillUnits>
                    <fillUnit unit="$l10n_unit_literShort" fillTypes="DIESEL"
                              capacity="4" showOnHud="true"/>
                </fillUnits>
            </fillUnitConfiguration>
        </fillUnitConfigurations>
    </fillUnit>

    <enterable>
        <enterReferenceNode node="enterNode" upperHeight="1.6" lowerHeight="0.05"/>
        <exitPoint node="exitNode"/>

        <cameras>
            <!-- вид от третьего лица -->
            <camera rotateNode="cameraOutside" isRotatable="true"
                    rotMinX="-1.05" rotMaxX="0.45"
                    transMin="1.8" transMax="6.0"
                    limit="true" useMirrors="false"/>
            <!-- вид с седла -->
            <camera rotateNode="cameraInside" isRotatable="true" isInside="true"
                    rotMinX="-0.85" rotMaxX="0.55"
                    limit="true" useMirrors="false"/>
        </cameras>

        <characterNode node="playerSeatNode"
                       cameraMinDistance="0.35"
                       characterIndex="1"
                       useAnimation="false"/>
    </enterable>

    <drivable>
        <steering wheelNode="handlebarNode" indoorRotation="42" outdoorRotation="42"/>
        <cruiseControl minSpeed="3" maxSpeed="65"/>
    </drivable>

    <lights>
        <!-- фара -->
        <states>
            <state1 lightTypes="0"/>
            <state2 lightTypes="0 1"/>
        </states>
        <realLights>
            <low>
                <light node="headlightLow" type="0"/>
            </low>
            <high>
                <light node="headlightHigh" type="1"/>
            </high>
        </realLights>
        <defaultLights>
            <light node="headlightGlass" decoration="false"/>
        </defaultLights>
        <brakeLights>
            <brakeLight node="brakeLightNode"/>
        </brakeLights>
        <reverseLights>
            <reverseLight node="brakeLightNode"/>
        </reverseLights>
        <turnLights>
            <turnLightLeft node="turnLightFrontLeft"/>
            <turnLightLeft node="turnLightRearLeft"/>
            <turnLightRight node="turnLightFrontRight"/>
            <turnLightRight node="turnLightRearRight"/>
        </turnLights>
    </lights>

    <honk>
        <sound template="carHorn" linkNode="alphaMoped" volumeScale="0.6"/>
    </honk>

    <washable>
        <dirtNode node="frameMesh"/>
        <dirtNode node="tankMesh"/>
        <dirtNode node="engineMesh"/>
    </washable>

    <wearable>
        <wearNode node="frameMesh"/>
    </wearable>

    <!-- Наша специализация: наклон корпуса в поворотах -->
    <alphaMopedLean node="bodyLean" maxAngle="22" speedFactor="0.055" smoothing="3.5"/>

    <i3dMappings>
        <i3dMapping id="alphaMoped"          node="0>"/>
        <i3dMapping id="bodyLean"            node="0>0"/>
        <i3dMapping id="frameMesh"           node="0>0|0"/>
        <i3dMapping id="tankMesh"            node="0>0|1"/>
        <i3dMapping id="seatMesh"            node="0>0|2"/>
        <i3dMapping id="engineMesh"          node="0>0|3"/>
        <i3dMapping id="exhaustMesh"         node="0>0|4"/>
        <i3dMapping id="rearRackMesh"        node="0>0|5"/>
        <i3dMapping id="fenderRearMesh"      node="0>0|6"/>
        <i3dMapping id="chainSprocket"       node="0>0|7"/>
        <i3dMapping id="engineNode"          node="0>0|8"/>
        <i3dMapping id="exhaustEffectNode"   node="0>0|9"/>
        <i3dMapping id="brakeLightNode"      node="0>0|10"/>
        <i3dMapping id="turnLightRearLeft"   node="0>0|11"/>
        <i3dMapping id="turnLightRearRight"  node="0>0|12"/>

        <i3dMapping id="handlebarNode"       node="0>0|13"/>
        <i3dMapping id="forkMesh"            node="0>0|13|0"/>
        <i3dMapping id="handlebarMesh"       node="0>0|13|1"/>
        <i3dMapping id="fenderFrontMesh"     node="0>0|13|2"/>
        <i3dMapping id="headlightGlass"      node="0>0|13|3"/>
        <i3dMapping id="headlightLow"        node="0>0|13|4"/>
        <i3dMapping id="headlightHigh"       node="0>0|13|5"/>
        <i3dMapping id="turnLightFrontLeft"  node="0>0|13|6"/>
        <i3dMapping id="turnLightFrontRight" node="0>0|13|7"/>

        <i3dMapping id="wheelFrontLeft"      node="0>1|0"/>
        <i3dMapping id="wheelFrontMesh"      node="0>1|0|0"/>
        <i3dMapping id="wheelFrontRight"     node="0>1|1"/>
        <i3dMapping id="wheelRearLeft"       node="0>1|2"/>
        <i3dMapping id="wheelRearMesh"       node="0>1|2|0"/>
        <i3dMapping id="wheelRearRight"      node="0>1|3"/>

        <i3dMapping id="enterNode"           node="0>2|0"/>
        <i3dMapping id="exitNode"            node="0>2|1"/>
        <i3dMapping id="playerSeatNode"      node="0>2|2"/>
        <i3dMapping id="cameraOutside"       node="0>2|3"/>
        <i3dMapping id="cameraInside"        node="0>2|4"/>
    </i3dMappings>

</vehicle>
